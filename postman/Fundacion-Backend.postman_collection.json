      "name": "Anomalías",
      "item": [
        {
          "name": "Crear anomalía",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"code\": \"ANOM-003\",\n    \"name\": \"El espejo de los recuerdos\",\n    \"description\": \"Un espejo que refleja acontecimientos del pasado de quien lo observa.\",\n    \"containmentClass\": \"Euclid\",\n    \"dangerLevel\": 3,\n    \"protocols\": [\n        {\n            \"title\": \"Protocolo de observación\",\n            \"description\": \"Limitar la exposición al espejo a cinco minutos.\"\n        }\n    ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/anomalies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "anomalies"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 && !pm.collectionVariables.get(\"anomalyId\")) {",
                  "    const body = pm.response.json();",
                  "    if (body.anomaly && body.anomaly._id) {",
                  "        pm.collectionVariables.set(\"anomalyId\", body.anomaly._id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        },
